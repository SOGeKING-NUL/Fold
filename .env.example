# ============================================
# FOLD BACKEND ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your actual values

# ============================================
# DATABASE
# ============================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL='postgresql://user:password@host:port/dbname?sslmode=require'

# ============================================
# ROBOFLOW (UPI Logo Detection)
# ============================================
# Get your API key from: https://roboflow.com/
ROBOFLOW_API_KEY='your_roboflow_api_key_here'
ROBOFLOW_UPI_MODEL_ID='fold-yf9a0/3'

# ============================================
# OLLAMA (Local LLM for OCR Text Structuring)
# ============================================
# Set to true to enable Ollama for better OCR text extraction
OLLAMA_ENABLED=true
OLLAMA_BASE_URL='http://127.0.0.1:11434'
OLLAMA_MODEL='qwen2.5:3b-instruct'
OLLAMA_TIMEOUT_SECONDS=120

# ============================================
# WEB DASHBOARD
# ============================================
# Frontend URL (for CORS)
FOLD_WEB_BASE_URL='http://localhost:3000'
FOLD_WEB_SIGNING_SECRET='change-this-to-a-random-secure-string'
FOLD_WEB_ORIGINS='http://localhost:3000'

# ============================================
# CLERK AUTHENTICATION
# ============================================
# Get your keys from: https://clerk.com/
# These should match the keys in web/.env.local
CLERK_SECRET_KEY='sk_test_your_clerk_secret_key_here'
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY='pk_test_your_clerk_publishable_key_here'

# ============================================
# REDIS (Optional - for background jobs)
# ============================================
# Only needed if you plan to use background job processing
REDIS_URL='redis://localhost:6379/0'

# ============================================
# TELEGRAM BOT (Optional)
# ============================================
# Uncomment if you want to enable Telegram bot integration
# TELE_BOT_HTTP_API='your_telegram_bot_token_here'
# TELEGRAM_WEBHOOK_SECRET='your_webhook_secret_here'
